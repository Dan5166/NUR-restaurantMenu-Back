{
  "collectionName": "components_shared_tags",
  "info": {
    "displayName": "Tag",
    "icon": "tag",
    "description": "Dish tags (vegetarian, vegan, spicy, etc.)"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 30
