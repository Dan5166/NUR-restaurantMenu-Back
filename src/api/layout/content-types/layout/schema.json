{
  "kind": "collectionType",
  "collectionName": "layouts",
  "info": {
    "singularName": "layout",
    "pluralName": "layouts",
    "displayName": "Layout",
    "description": "Predefined layout templates for menu display"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 50
    },
    "description": {
      "type": "text",
      "maxLength": 200
    },
    "previewImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "type": {
      "type": "enumeration",
      "enum": ["grid", "list", "cards", "masonry"],
      "default": "grid",
      "required": true
    },
    "config": {
      "type": "json",
      "required": true
    },
    "isDefault": {
      "type": "boolean",
      "default": false
    },
    "restaurants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::restaurant.restaurant",
      "mappedBy": "layout"
    }
  }
}
