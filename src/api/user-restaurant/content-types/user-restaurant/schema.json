{
  "kind": "collectionType",
  "collectionName": "user_restaurants",
  "info": {
    "singularName": "user-restaurant",
    "pluralName": "user-restaurants",
    "displayName": "User Restaurant",
    "description": "Junction table for many-to-many relationship between users and restaurants"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "restaurant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::restaurant.restaurant"
    },
    "role": {
      "type": "enumeration",
      "enum": ["owner", "admin", "staff"],
      "default": "staff",
      "required": true
    }
  }
}
