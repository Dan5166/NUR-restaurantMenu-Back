{
  "kind": "collectionType",
  "collectionName": "restaurants",
  "info": {
    "singularName": "restaurant",
    "pluralName": "restaurants",
    "displayName": "Restaurant",
    "description": "Restaurant information and configuration"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "address": {
      "type": "text",
      "maxLength": 300
    },
    "phone": {
      "type": "string",
      "maxLength": 20
    },
    "email": {
      "type": "email"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "plan": {
      "type": "enumeration",
      "enum": ["free", "basic", "premium", "enterprise"],
      "default": "free"
    },
    "contactInfo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.contact-info"
    },
    "theme": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::theme.theme",
      "inversedBy": "restaurants"
    },
    "layout": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::layout.layout",
      "inversedBy": "restaurants"
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "restaurant"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::dish.dish",
      "mappedBy": "restaurant"
    },
    "userRestaurants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-restaurant.user-restaurant",
      "mappedBy": "restaurant"
    },
    "menus": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu.menu",
      "mappedBy": "restaurant"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
